; Godot 4 Projekt-Manifest — "Rust & Lead" (Phase 2).
; Projekt-Wurzel ist dieser Ordner (godot/), daher res:// == godot/.
; Logik-Backend + headless Test-Runner + erste sichtbare Szene:
;   Hauptszene = Overworld (Kraterboden im GDD-Maßstab, §1.4) — Play in Xogot/Editor.
;   Tests laufen explizit: godot --headless --path godot res://tests/TestRunner.tscn

config_version=5

[application]

config/name="Rust & Lead"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.3")

[display]

; ── Die wichtigste Einstellung für das Handy, und sie fehlte ─────────────────────
; Ohne Streckung zeichnet Godot die Oberfläche in ECHTEN Pixeln. Auf einem Telefon mit
; 2400 px Breite ist ein 52-px-Knopf dann 2 % der Bildschirmbreite — deshalb war der
; Charakter-Knopf im ersten Handy-Test praktisch unsichtbar, obwohl er am Computer gut saß.
; Es war nie ein Fehler am Knopf; es fehlte die Skalierung für alle.
;
; `canvas_items` rechnet die gesamte Oberfläche von 1280×720 auf die echte Auflösung hoch.
; Eine Größe in Pixeln bedeutet damit auf jedem Gerät dasselbe. `expand` behält das
; Seitenverhältnis des Geräts und gibt den Überschuss als zusätzliches Blickfeld dazu,
; statt schwarze Balken zu setzen — ein 20:9-Telefon sieht also mehr Wüste, nicht kleinere
; Knöpfe.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[autoload]

; Reihenfolge zählt: GameState zuerst, dann die abhängigen Manager.
GameState="*res://scripts/GameState.gd"
QuestManager="*res://scripts/QuestManager.gd"
TycoonManager="*res://scripts/TycoonManager.gd"

[input_devices]

; Maus-Drag emuliert den Touch-Joystick — gleiche Steuerung am Desktop wie am Handy.
pointing/emulate_touch_from_mouse=false

[rendering]

; ── Ohne diese Zeile laesst sich das Spiel nicht auf Android exportieren ────────
; „Die Target-Plattform benoetigt ETC2/ASTC-Texturkompression."
;
; Handy-Grafikchips koennen die Kompression nicht, die Godot fuer den Schreibtisch
; erzeugt (S3TC/BPTC). Ohne ETC2/ASTC bricht der Export ab, bevor er anfaengt — es ist
; keine Warnung, sondern ein Riegel.
;
; Steht hier und nicht in einer Anleitung zum Nachklicken, weil es eine
; PROJEKT-Einstellung ist: Sie gehoert zum Spiel, nicht zum Rechner, auf dem es gebaut
; wird. Einmal eingetragen, gilt sie fuer jeden, der das Projekt oeffnet.
;
; Beim ersten Start danach importiert Godot alle Texturen neu und legt zusaetzlich die
; Handy-Fassung an. Das dauert und ist einmalig.
textures/vram_compression/import_etc2_astc=true

; Mobile-Renderer: performant auf iPhone/iPad (Xogot) wie am Desktop.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
lights_and_shadows/directional_shadow/size=4096
; 2048 auf dem Handy statt 4096.
;
; Der Schattenpuffer wird in JEDEM Bild neu gezeichnet, und 4096² ist auf einem Telefon eine
; teure Flaeche — bei 38 m Schattenreichweite (`CAM_SHADOW_M`) bringt die vierfache Aufloesung
; dort kaum sichtbar schaerfere Kanten, kostet aber Speicher und Fuellrate in jedem Bild.
; Am Rechner bleibt es bei 4096.
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[gui]

; Die Schrift liegt IM Projekt, sie wird nicht vom System geliehen.
;
; Godots eingebaute Ersatzschrift ist ein schmaler Latin-Ausschnitt: kein ⚡, kein ⚗, kein
; einziges Symbol. Alle Zeichen der Oberflaeche standen deshalb im Spiel als leere Kaestchen —
; die Trankzahl neben einem Nichts, ueber den Gegnern ein Loch statt „betaeubt". Gesehen hat
; man es erst, als `Font.has_char()` bei jedem Symbol einzeln „nein" sagte.
;
; DejaVu Sans deckt Umlaute, Typografie und die Symbolbloecke ab (Lizenz: Bitstream Vera,
; siehe assets/fonts/LIZENZ_DejaVu.txt). Was sie NICHT hat, hat keine normale Schrift: den
; Emoji-Bereich ab U+1F300. Welche Zeichen erlaubt sind, steht in `scripts/HudGlyph.gd`, und
; `TestRunner._test_zeichen()` fragt die Schrift bei jedem einzeln nach.
theme/custom_font="res://assets/fonts/DejaVuSans.ttf"
